[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

[libraries]
macos.debug = "res://../target/debug/libgamesynth_godot.dylib"
macos.release = "res://../target/release/libgamesynth_godot.dylib"
linux.debug.x86_64 = "res://../target/debug/libgamesynth_godot.so"
linux.release.x86_64 = "res://../target/release/libgamesynth_godot.so"
linux.debug.arm64 = "res://../target/debug/libgamesynth_godot.so"
linux.release.arm64 = "res://../target/release/libgamesynth_godot.so"
windows.debug.x86_64 = "res://../target/debug/gamesynth_godot.dll"
windows.release.x86_64 = "res://../target/release/gamesynth_godot.dll"
